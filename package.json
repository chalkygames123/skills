{
	"name": "root",
	"type": "module",
	"scripts": {
		"fmt": "wireit",
		"fmt:check": "wireit"
	},
	"wireit": {
		"fmt": {
			"command": "oxfmt"
		},
		"fmt:check": {
			"command": "oxfmt --check"
		}
	},
	"devDependencies": {
		"oxfmt": "catalog:",
		"wireit": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.1.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "26.8.1",
			"onFail": "download"
		}
	}
}
